# --- Secrets (NEVER commit) ---
.env
.env.local
.env.*.local
.env.bak
# Keep the template so new clones know which vars to set:
!.env.example

# --- Personal content ---
# Data dir holds real stakeholder memories and local PRD drafts.
# Regenerable via `scripts.seed`. Back up separately if needed.
data/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
*.egg
dist/
build/

# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Claude Code per-machine settings ---
# launch.json is shareable dev-server config; settings.local.json is personal.
.claude/settings.local.json
# Transient agent worktrees created during Claude Code sessions.
.claude/worktrees/

# --- Code signing / notarization / updater keys (NEVER commit) ---
# Apple Developer ID certs, provisioning, and the Tauri updater private key
# live in the Keychain and in GitHub Actions secrets — never in the repo.
*.p12
*.pfx
*.cer
*.pem
*.mobileprovision
*.key
