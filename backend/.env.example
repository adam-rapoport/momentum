# Copy this file to `.env` and fill in your values.
# `.env` is gitignored; `.env.example` is committed as a template.

# --- Database ---
# Default: a self-contained SQLite file (no service to install). This is the
# desktop default.
DATABASE_URL=sqlite+aiosqlite:///./pmomentum.db
# Alternative: Postgres (Homebrew Postgres has no password; uses your macOS
# username). Uncomment to use instead of SQLite.
# DATABASE_URL=postgresql+asyncpg://adamrapoport@localhost:5432/pmomentum

# --- Groq (LLM provider) ---
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Heavy model for drafting turns (PRDs, stakeholder updates, meeting prep).
# See app/core/model_router.py for routing rules. Despite the GROQ_ prefix
# (kept for backwards compat), this can be any provider's model ID —
# `gemini-*` / `gemma-*` routes to Google AI Studio, otherwise Groq.
GROQ_HEAVY_MODEL=gemma-4-31b-it

# --- Google AI Studio (for heavy-model drafting) ---
# Get a key at https://aistudio.google.com/app/apikey
# Only required if GROQ_HEAVY_MODEL is a gemini-* or gemma-* model.
GOOGLE_AI_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Web search (WebSearch tool) ---
# Tavily is the default provider; Perplexity is an alternative. You can also
# set these in the app under Settings → Integrations → Web Search.
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# --- Credential vault (C8 Connections) ---
# Required to store API keys / OAuth tokens entered through the UI. Generate
# once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_VAULT_KEY=

# NOTE (C8): As of Sprint 7, API keys above can also be entered in the app's
# first-run wizard / Settings instead of here. Values in this file act as
# defaults/fallbacks when no key has been saved in the UI.

# --- App ---
# Used for CORS and app-level config. For local dev, leave as-is.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# --- Crash reporting (optional) ---
# Leave blank to disable. Set a Sentry DSN to send crash reports. Off by
# default — the app never phones home unless you opt in here.
SENTRY_DSN=
