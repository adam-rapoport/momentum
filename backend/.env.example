# Copy this file to `.env` and fill in your values.
# `.env` is gitignored; `.env.example` is committed as a template.

# --- Data directory (desktop) ---
# Leave UNSET for web dev — files then live in the repo (./pmomentum.db,
# pmomentum/data/memory) as before. The desktop launcher (app/desktop.py) sets
# this automatically to a per-user folder (macOS: ~/Library/Application Support/
# pMomentum). When set, the SQLite DB, memory/documents, and an auto-generated
# credential vault key all root here. Any explicit value you set below
# (DATABASE_URL, MEMORY_ROOT, CREDENTIAL_VAULT_KEY) still wins over it.
# DATA_DIR=

# --- Database ---
# Optional. If omitted, defaults to a self-contained SQLite file (no service to
# install) — in the cwd for web dev, or inside DATA_DIR on desktop.
DATABASE_URL=sqlite+aiosqlite:///./pmomentum.db
# Alternative: Postgres (Homebrew Postgres has no password; uses your macOS
# username). Uncomment to use instead of SQLite.
# DATABASE_URL=postgresql+asyncpg://adamrapoport@localhost:5432/pmomentum

# --- Groq (LLM provider) ---
# Get your key at https://console.groq.com/keys. Optional at startup — you can
# also enter it in the app's first-run wizard / Settings (stored encrypted).
# Leave blank and the app boots straight to onboarding.
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Heavy model for drafting turns (PRDs, stakeholder updates, meeting prep).
# See app/core/model_router.py for routing rules. Despite the GROQ_ prefix
# (kept for backwards compat), this can be any provider's model ID —
# `gemini-*` / `gemma-*` routes to Google AI Studio, otherwise Groq.
GROQ_HEAVY_MODEL=gemini-3.5-flash

# --- Google AI Studio (for heavy-model drafting) ---
# Get a key at https://aistudio.google.com/app/apikey
# Only required if GROQ_HEAVY_MODEL is a gemini-* or gemma-* model.
GOOGLE_AI_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Optional LLM providers (all keys can also be entered in Settings) ---
# OpenAI (paid): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic Claude (paid): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenRouter (one key, many labs): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Mistral: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
# Ollama (local models): base URL of your local server. Usually left unset
# and connected in Settings instead — a standard install is http://localhost:11434
OLLAMA_BASE_URL=

# --- Web search (WebSearch tool) ---
# Tavily is the default provider; Perplexity is an alternative. You can also
# set these in the app under Settings → Integrations → Web Search.
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# --- Google integration (Docs / Gmail / Calendar OAuth) ---
# Required for "Settings → Integrations → Google → Connect". Create an OAuth
# client in Google Cloud Console — see docs/google-connect-setup.md.
# Leave blank to disable Google integration (Connect shows a clear message).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# --- Credential vault (C8 Connections) ---
# Encrypts API keys / OAuth tokens entered through the UI. For web dev, generate
# one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# On desktop (DATA_DIR set) this is generated and persisted automatically on
# first run (DATA_DIR/vault.key) if left blank — no manual step needed.
CREDENTIAL_VAULT_KEY=

# NOTE (C8): As of Sprint 7, API keys above can also be entered in the app's
# first-run wizard / Settings instead of here. Values in this file act as
# defaults/fallbacks when no key has been saved in the UI.

# --- App ---
# Used for CORS and app-level config. For local dev, leave as-is.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# --- Crash reporting (optional) ---
# Leave blank to disable. Set a Sentry DSN to send crash reports. Off by
# default — the app never phones home unless you opt in here.
SENTRY_DSN=
